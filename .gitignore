# ==============================
# MediRevolution Git Ignore
# ==============================

# Maven / Build
target/
**/target/

# Eclipse
.metadata/
**/.metadata/
.settings/
**/.settings/
.project
**/.project
.classpath
**/.classpath/

# IntelliJ
.idea/
**/.idea/
*.iml

# VS Code
.vscode/

# Environment / Secrets
.env
.env.*
!.env.example

# Keys / Certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Database Backups
db-backups/
*.dump
*.backup
*.bak

# Logs
*.log
logs/
**/logs/

# Docker image / transfer archives
*.tar
*.tar.gz

# ==============================
# Runtime Patient Document Vault
# ==============================
#
# Uploaded clinical documents are runtime/private data.
# They must NEVER be committed to Git.
#
**/data/patient-documents/

# OS
.DS_Store
Thumbs.db

# Temporary Files
*.tmp
*.temp
*.swp
~$*